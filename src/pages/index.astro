---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" activeTab="about">
  <div style="animation: fadeIn 0.5s ease-out; padding-top: 16vh; padding-bottom: 12vh;">
    <div class="home-hero-grid">
      <div class="home-hero-left">
        <!-- Large Bold Central/Modern Text -->
        <h1 class="hero-text">
          yo <span class="emoji">👋</span> i'm davide<br/>
          <span class="highlight">phd student</span> in physics of <span class="gradient-text">active matter</span>
        </h1>

        <div class="bio-text">
          <p>
            I am a PhD candidate at Gulliver Lab, ESPCI Paris, working under the supervision of Prof. Ludovic Berthier. My research focuses on active and disordered systems using numerical simulations and statistical physics tools to understand non-equilibrium phase transitions and glassy dynamics.
          </p>
          <p>
            Previously, I graduated with a Master's in Physics of Complex Systems (Politecnico di Torino, SISSA, Université Paris Cité), working on Boltzmann Inversion and force inference methods.
          </p>
        </div>
      </div>

      <div class="home-hero-right">
        <div class="profile-card">
          <img src="/assets/profile_pic.jpg" alt="Davide Paolino" class="profile-img" />
          <h2 class="profile-name">Davide Paolino</h2>
          <div class="profile-title">PhD Student in Physics</div>
          <p style="font-size: 0.85rem; color: var(--text-tertiary); margin-bottom: 1rem;">
            <a href="https://www.gulliver.espci.fr/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: underline;">
              Gulliver Lab, ESPCI-Paris PSL
            </a>
          </p>
          <div class="social-links">
            <a href="mailto:davide.paolino@espci.fr" class="social-icon" title="Email">
              <i class="fa-regular fa-envelope"></i>
            </a>
            <a href="https://github.com/paolinodavide" target="_blank" rel="noopener noreferrer" class="social-icon" title="GitHub">
              <i class="fa-brands fa-github"></i>
            </a>
            <a href="https://www.linkedin.com/in/davide-paolino-58085418b" target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn">
              <i class="fa-brands fa-linkedin-in"></i>
            </a>
            <a href="https://orcid.org/0009-0003-6658-2779" target="_blank" rel="noopener noreferrer" class="social-icon" title="ORCID">
              <i class="fa-brands fa-orcid"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Down Interests Redirecting to Publications -->
    <div class="section-divider"></div>
    
    <div class="interests-section">
      <h2 style="font-family: var(--font-serif); margin-bottom: 0.75rem;">Research Interests</h2>
      <p style="color: var(--text-secondary); margin-bottom: 2rem; font-size: 1rem;">
        Click on any area below to view related publications:
      </p>
      
      <div class="interests-grid">
        <a href="/publications" class="interest-card-link">
          <div class="interest-card">
            <div class="interest-icon">🔋</div>
            <h3 class="interest-title">Active Matter <i class="fa-solid fa-arrow-right-long arrow-icon"></i></h3>
            <p style="font-size: 0.925rem; color: var(--text-secondary); margin-bottom: 0; line-height: 1.5;">
              Investigating collective motions and dynamic glassiness of self-propelled particle configurations.
            </p>
          </div>
        </a>

        <a href="/publications" class="interest-card-link">
          <div class="interest-card">
            <div class="interest-icon">🔍</div>
            <h3 class="interest-title">Inverse Problems <i class="fa-solid fa-arrow-right-long arrow-icon"></i></h3>
            <p style="font-size: 0.925rem; color: var(--text-secondary); margin-bottom: 0; line-height: 1.5;">
              Measuring pair interactions and forces directly from empirical configurations.
            </p>
          </div>
        </a>

        <a href="/publications" class="interest-card-link">
          <div class="interest-card">
            <div class="interest-icon">🕸️</div>
            <h3 class="interest-title">Statistical Mechanics <i class="fa-solid fa-arrow-right-long arrow-icon"></i></h3>
            <p style="font-size: 0.925rem; color: var(--text-secondary); margin-bottom: 0; line-height: 1.5;">
              Analyzing out-of-equilibrium phase transitions in disordered systems.
            </p>
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .home-hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .home-hero-right {
      order: -1;
    }
  }

  .hero-text {
    font-family: var(--font-sans);
    font-size: 2.85rem;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 2rem;
    color: var(--text-primary);
    text-transform: lowercase;
  }

  .highlight {
    color: var(--color-primary);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .bio-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 680px;
  }

  .section-divider {
    height: 1px;
    background-color: var(--border-color);
    margin: 4rem 0 3rem 0;
  }

  .interest-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .interest-card-link:hover {
    color: inherit;
  }

  .arrow-icon {
    font-size: 0.85rem;
    margin-left: 0.25rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
    color: var(--color-primary);
  }

  .interest-card:hover .arrow-icon {
    opacity: 1;
    transform: translateX(0);
  }
</style>
