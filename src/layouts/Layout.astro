---
import '@fortawesome/fontawesome-free/css/all.min.css';
import { getSearchIndex } from '../utils/searchIndex';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTab?: string;
  image?: string;
}

const { 
  title, 
  description = "Davide Paolino - PhD Candidate in Physics at Gulliver Lab, ESPCI Paris.", 
  activeTab = "",
  image = "/assets/profile_pic.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://paolinodavide.github.io');
const ogImageUrl = new URL(image, Astro.site || 'https://paolinodavide.github.io');

const searchIndex = await getSearchIndex();

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Davide Paolino",
  "jobTitle": "PhD Candidate in Physics",
  "worksFor": {
    "@type": "EducationalOrganization",
    "name": "Gulliver Lab, ESPCI Paris PSL"
  },
  "url": canonicalURL.href,
  "sameAs": [
    "https://github.com/paolinodavide",
    "https://www.linkedin.com/in/davide-paolino-58085418b",
    "https://orcid.org/0009-0003-6658-2779"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Davide Paolino</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Davide Paolino's Blog" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Davide Paolino`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Davide Paolino" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Theme initialization -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <header>
      <div class="container nav-container">
        <a href="/" class="logo">
          Davide <span>Paolino</span>
        </a>
        <nav style="display: flex; align-items: center;">
          <ul class="nav-links">
            <li><a href="/" class={activeTab === 'about' ? 'active' : ''}>About</a></li>
            <li><a href="/publications" class={activeTab === 'publications' ? 'active' : ''}>Publications</a></li>
            <li><a href="/cv" class={activeTab === 'cv' ? 'active' : ''}>CV</a></li>
            <!-- <li><a href="/blog" class={activeTab === 'blog' ? 'active' : ''}>Blog</a></li> -->
          </ul>
          
          <div class="header-actions">
            <button id="search-btn" class="search-bar-btn" title="Search (Ctrl+K)">
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Search...</span>
              <span class="search-hint">⌘K</span>
            </button>
            <button id="theme-toggle" class="icon-btn" title="Toggle theme">
              <i class="fa-solid fa-moon"></i>
            </button>
          </div>
        </nav>
      </div>
    </header>

    <div class="container">
      <main class="layout-single">
        <slot />
      </main>
    </div>

    <footer style="margin-top: 5rem; padding: 2rem 0; border-top: 1px solid var(--border-color); text-align: center; font-size: 0.9rem; color: var(--text-tertiary);">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Davide Paolino. Powered by Astro.</p>
      </div>
    </footer>

    <!-- Search Modal Dialog -->
    <div id="search-modal" class="modal-overlay" data-index={JSON.stringify(searchIndex)}>
      <div class="modal-container">
        <div class="search-input-wrapper">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="search-input" class="search-input" placeholder="Type to search papers, posts, skills, or CV..." autocomplete="off" />
        </div>
        <ul id="search-results" class="search-results">
          <!-- dynamically rendered -->
        </ul>
        <div class="modal-footer">
          <div class="modal-footer-shortcuts">
            <div class="modal-footer-shortcut">
              <kbd>↑↓</kbd> <span>navigate</span>
            </div>
            <div class="modal-footer-shortcut">
              <kbd>↵</kbd> <span>select</span>
            </div>
          </div>
          <div class="modal-footer-shortcut">
            <kbd>esc</kbd> <span>close</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script>
      // 1. Theme Logic
      const themeToggle = document.getElementById('theme-toggle');
      const getTheme = () => document.documentElement.getAttribute('data-theme') || 'light';
      
      const updateToggleIcon = (theme) => {
        if (themeToggle) {
          const icon = themeToggle.querySelector('i');
          if (icon) {
            icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
          }
        }
      };

      updateToggleIcon(getTheme());

      themeToggle?.addEventListener('click', () => {
        const currentTheme = getTheme();
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateToggleIcon(newTheme);
      });

      // 2. Command Palette Fuzzy & Categorized Search Logic
      const searchBtn = document.getElementById('search-btn');
      const searchModal = document.getElementById('search-modal');
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const searchResults = document.getElementById('search-results');
      
      let searchData: any[] = [];
      try {
        searchData = JSON.parse(searchModal?.getAttribute('data-index') || '[]');
      } catch (e) {
        console.error('Failed to parse search data index', e);
      }

      let selectedIndex = 0;
      let flatResults: any[] = [];

      const openSearch = () => {
        searchModal?.classList.add('open');
        searchInput?.focus();
        renderResults('');
      };

      const closeSearch = () => {
        searchModal?.classList.remove('open');
        if (searchInput) searchInput.value = '';
      };

      const scoreItem = (item: any, tokens: string[]) => {
        let score = 0;
        const titleLower = (item.title || '').toLowerCase();
        const subtitleLower = (item.subtitle || '').toLowerCase();
        const keywordsLower = (item.keywords || '').toLowerCase();
        const descLower = (item.description || '').toLowerCase();
        const catLower = (item.category || '').toLowerCase();

        for (const token of tokens) {
          if (!token) continue;
          if (titleLower.includes(token)) score += 12;
          if (subtitleLower.includes(token)) score += 6;
          if (catLower.includes(token)) score += 5;
          if (keywordsLower.includes(token)) score += 4;
          if (descLower.includes(token)) score += 2;
        }

        return score;
      };

      const renderResults = (query: string) => {
        if (!searchResults) return;
        
        const q = query.toLowerCase().trim();
        const tokens = q.split(/\s+/).filter(Boolean);

        if (!q) {
          // Show primary pages by default when input is empty
          flatResults = searchData.slice(0, 8);
        } else {
          // Score and filter items
          const scored = searchData
            .map(item => ({ item, score: scoreItem(item, tokens) }))
            .filter(entry => entry.score > 0)
            .sort((a, b) => b.score - a.score);

          flatResults = scored.map(entry => entry.item);
        }

        selectedIndex = 0;

        if (flatResults.length === 0) {
          searchResults.innerHTML = `<li style="padding: 1.25rem; color: var(--text-tertiary); font-size: 0.95rem; text-align: center;">No results found for "${query}"</li>`;
          return;
        }

        searchResults.innerHTML = flatResults.map((item, idx) => `
          <li class="search-item ${idx === selectedIndex ? 'selected' : ''}" data-index="${idx}">
            <a href="${item.url}">
              <div style="display: flex; flex-direction: column; gap: 0.2rem; width: 100%;">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                  <span style="font-weight: 600; color: var(--text-primary);">${item.title}</span>
                  <span class="search-item-meta">${item.category}</span>
                </div>
                ${item.subtitle ? `<span style="font-size: 0.8rem; color: var(--color-primary); opacity: 0.9;">${item.subtitle}</span>` : ''}
                ${item.description ? `<span style="font-size: 0.825rem; color: var(--text-secondary); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${item.description}</span>` : ''}
              </div>
            </a>
          </li>
        `).join('');

        // Hover listeners
        const renderedItems = searchResults.querySelectorAll('.search-item');
        renderedItems.forEach((el) => {
          el.addEventListener('mouseenter', () => {
            const idx = parseInt(el.getAttribute('data-index') || '0');
            updateSelection(idx);
          });
        });
      };

      const updateSelection = (newIndex: number) => {
        if (!searchResults) return;
        const items = searchResults.querySelectorAll('.search-item');
        if (items[selectedIndex]) items[selectedIndex].classList.remove('selected');
        selectedIndex = newIndex;
        if (items[selectedIndex]) items[selectedIndex].classList.add('selected');
      };

      // Listeners
      searchBtn?.addEventListener('click', openSearch);
      
      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) {
          closeSearch();
        }
      });

      searchInput?.addEventListener('input', (e) => {
        renderResults((e.target as HTMLInputElement).value);
      });

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (searchModal?.classList.contains('open')) {
            closeSearch();
          } else {
            openSearch();
          }
        }

        if (e.key === 'Escape' && searchModal?.classList.contains('open')) {
          e.preventDefault();
          closeSearch();
        }

        if (searchModal?.classList.contains('open') && flatResults.length > 0) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIdx = (selectedIndex + 1) % flatResults.length;
            updateSelection(nextIdx);
            const activeEl = searchResults?.children[nextIdx] as HTMLElement;
            activeEl?.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIdx = (selectedIndex - 1 + flatResults.length) % flatResults.length;
            updateSelection(prevIdx);
            const activeEl = searchResults?.children[prevIdx] as HTMLElement;
            activeEl?.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter') {
            e.preventDefault();
            const activeItem = flatResults[selectedIndex];
            if (activeItem) {
              window.location.href = activeItem.url;
            }
          }
        }
      });
    </script>
  </body>
</html>
