---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTab?: string;
}

const { title, description = "Davide Paolino - PhD Candidate in Physics", activeTab = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Davide Paolino</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body>
    <header>
      <div class="container nav-container">
        <a href="/" class="logo">
          Davide <span>Paolino</span>
        </a>
        <nav>
          <ul class="nav-links">
            <li><a href="/" class={activeTab === 'about' ? 'active' : ''}>About</a></li>
            <li><a href="/interests" class={activeTab === 'interests' ? 'active' : ''}>Interests</a></li>
            <li><a href="/publications" class={activeTab === 'publications' ? 'active' : ''}>Publications</a></li>
            <li><a href="/cv" class={activeTab === 'cv' ? 'active' : ''}>CV</a></li>
            <li><a href="/blog" class={activeTab === 'blog' ? 'active' : ''}>Blog</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <div class="container">
      <main class="layout-grid">
        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="profile-card">
            <img src="/assets/profile_pic.jpg" alt="Davide Paolino" class="profile-img" />
            <h2 class="profile-name">Davide Paolino</h2>
            <div class="profile-title">PhD Candidate in Physics</div>
            <p style="font-size: 0.85rem; color: var(--text-tertiary); margin-bottom: 1rem;">
              Gulliver Lab, ESPCI-Paris PSL
            </p>
            <div class="social-links">
              <a href="mailto:davide.paolino@espci.fr" class="social-icon" title="Email">
                <i class="fa-regular fa-envelope"></i>
              </a>
              <a href="https://github.com/paolinodavide" target="_blank" rel="noopener noreferrer" class="social-icon" title="GitHub">
                <i class="fa-brands fa-github"></i>
              </a>
              <a href="https://www.linkedin.com/in/davide-paolino-58085418b" target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn">
                <i class="fa-brands fa-linkedin-in"></i>
              </a>
              <a href="https://orcid.org/0009-0003-6658-2779" target="_blank" rel="noopener noreferrer" class="social-icon" title="ORCID">
                <i class="fa-brands fa-orcid"></i>
              </a>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <section class="content-area">
          <slot />
        </section>
      </main>
    </div>

    <footer style="margin-top: 5rem; padding: 2rem 0; border-top: 1px solid var(--border-color); text-align: center; font-size: 0.9rem; color: var(--text-tertiary);">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Davide Paolino. Powered by Astro.</p>
      </div>
    </footer>
  </body>
</html>
